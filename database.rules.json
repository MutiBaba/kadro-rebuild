{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['createdAt'])"
      }
    },
    "publicRooms": {
      ".read": true,
      "$roomCode": {
        ".write": true,
        ".validate": "newData.hasChildren(['hostName', 'maxPlayers', 'createdAt'])"
      }
    }
  }
}
